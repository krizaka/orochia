# -------------------------------------------------------------
# Orochia — environment template (copy to .env for local development)
# In production every secret below is mandatory: a missing value makes the
# request that needs it fail with 503 instead of running on a placeholder.
# -------------------------------------------------------------

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# At least 32 random characters (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Local only: lets the login page switch between the seeded demo accounts and
# settles payments instantly when no gateway is configured. Ignored in production.
OROCHIA_DEMO_MODE=true

# Default user — the platform owner (ADMIN, verified). Created or reactivated by the release job
# (migrate.cjs) and by the local seed; an existing account keeps its password.
# OROCHIA_OWNER_PASSWORD is needed only to create it (10+ characters).
OROCHIA_OWNER_EMAIL=
OROCHIA_OWNER_USERNAME=
OROCHIA_OWNER_NAME=
OROCHIA_OWNER_PASSWORD=

# PostgreSQL
DATABASE_URL=postgresql://orochia_user:orochia_secret@localhost:5432/orochia_db?sslmode=disable
# CA of a managed PostgreSQL (PEM), verified with TLS; on DigitalOcean App Platform: ${<db>.CA_CERT}
# DATABASE_CA_CERT=
DATABASE_MAX_CONNECTIONS=20

# Bunny.net Stream (video)
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_HOSTNAME=
# Optional collections (UUIDs from Manage library → Collections), to keep the library tidy:
# every new video, story videos, and the originals of editor drafts (deleted with their draft).
BUNNY_STREAM_COLLECTION_ID=
BUNNY_STREAM_STORIES_COLLECTION_ID=
BUNNY_STREAM_DRAFTS_COLLECTION_ID=
BUNNY_STREAM_TOKEN_AUTH_KEY=
# The library's Read-Only API key (Stream → API): Bunny signs every webhook with it (v1, HMAC-SHA256).
BUNNY_WEBHOOK_SECRET=

# ── Storage quotas (apps/web/lib/quotas.ts, docs/MEDIA_PIPELINE.md §6) ─────────────────────────
# The application counts what it keeps at Bunny (bytes and minutes, per creator and in total) and refuses an upload
# that does not fit BEFORE signing it (413/429 with a stable code). Sizes: 500MB, 200GB, 1TB or unlimited.
# STORAGE_LIMITS=off disables the quotas (not the rate limits) — refused in production unless
# STORAGE_LIMITS_OFF_CONFIRMED=true records that decision. Defaults below are deliberately small for development.
STORAGE_LIMITS=on
# STORAGE_LIMITS_OFF_CONFIRMED=
# The whole platform (GB, minutes): past it, new uploads are refused; operators are alerted at the thresholds (%).
QUOTA_PLATFORM_GB=100
QUOTA_PLATFORM_MINUTES=unlimited
QUOTA_ALERT_THRESHOLDS=80,95
# A creator without a plan; named plans an operator gives an account (PATCH /api/admin/storage/<userId>), and the
# plan of ADMIN accounts (the owner).
QUOTA_CREATOR_DEFAULT_GB=10
QUOTA_CREATOR_DEFAULT_MINUTES=600
QUOTA_PLANS=pro=100GB/3000min,unlimited=unlimited
QUOTA_ADMIN_PLAN=unlimited
# Per file, lower than (never above) the hard limits of packages/media/src/limits.ts (4 GB / 180 min, 250 MB, 400 MB).
# QUOTA_VIDEO_MAX_MB=4096
# QUOTA_VIDEO_MAX_MINUTES=180
# QUOTA_STORY_MAX_MB=250
# QUOTA_DRAFT_MAX_MB=400
# Upload sessions (videos, video stories, drafts) per account and 24 h; sessions still waiting for their bytes;
# pictures (avatars, covers, thumbnails, story images) per account and day.
QUOTA_UPLOADS_PER_DAY=50
QUOTA_CONCURRENT_UPLOADS=3
QUOTA_IMAGE_UPLOADS_PER_DAY=100
# Reconciliation with Bunny (also `npm run quota:reconcile` and POST /api/admin/storage): every N minutes, 0 = never.
QUOTA_RECONCILE_INTERVAL_MINUTES=360
# Optional: Bunny's ACCOUNT API key (Account → API) — adds the library's and the storage zone's own totals to each
# reconciliation. BUNNY_STORAGE_ZONE_ID: the zone's numeric id (else it is searched by BUNNY_STORAGE_ZONE).
BUNNY_ACCOUNT_API_KEY=
# BUNNY_STORAGE_ZONE_ID=

# ── Abuse defences (apps/web/lib/abuse/, apps/web/lib/rate-limit.ts, SECURITY.md) ───────────────
# Rate-limit counters: memory (one instance only) or postgres (shared by every instance — required before scaling out).
RATE_LIMIT_STORE=memory
# The visitor's address: a header the edge sets (DigitalOcean App Platform: do-connecting-ip), else the entry
# TRUSTED_PROXY_HOPS from the right of X-Forwarded-For (its left end is whatever the client wrote).
# CLIENT_IP_HEADER=do-connecting-ip
# TRUSTED_PROXY_HOPS=1
# Bot challenge: Cloudflare Turnstile ("Invisible" widget) on sign-up and password reset.
#   auto (default) — on when both keys are set · required — production refuses those actions without keys · off
# Local testing keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
BOT_CHALLENGE=auto
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sign-up: seconds a form must have been open before it is sent (bots are faster), extra blocked / allowed domains.
SIGNUP_MIN_FILL_SECONDS=3
# BLOCKED_EMAIL_DOMAINS=
# ALLOWED_EMAIL_DOMAINS=
# Bind signed playback URLs to the viewer's IP (Bunny token IP check). Off by default: check on real traffic first.
# BUNNY_TOKEN_BIND_IP=on

# Editor drafts: days a draft is kept (then removed with its files), drafts per account.
DRAFT_RETENTION_DAYS=30
DRAFTS_MAX_PER_USER=20

# Media storage (avatars, thumbnails, story images, drafts' music, 2257 documents). Production requires "bunny".
STORAGE_DRIVER=local
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ENDPOINT=storage.bunnycdn.com
BUNNY_PULL_ZONE_HOSTNAME=

# Payments — a gateway is offered only when ALL of its variables are set.
PLATFORM_FEE_PERCENTAGE=10

# CCBill (FlexForms dynamic pricing; postbacks signed by your webhook relay)
CCBILL_CLIENT_ACCOUNT=
CCBILL_CLIENT_SUBACCOUNT=
CCBILL_FORM_NAME=
CCBILL_SALT=
CCBILL_WEBHOOK_SECRET=

# Segpay
SEGPAY_MERCHANT_ID=
SEGPAY_PACKAGE_ID=
SEGPAY_SECRET_KEY=

# NowPayments (crypto) — IPN callback: ${NEXT_PUBLIC_APP_URL}/api/webhooks/payments/crypto
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Stripe — webhook endpoint: ${NEXT_PUBLIC_APP_URL}/api/webhooks/payments/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability — bearer token for /api/metrics (mandatory in production)
METRICS_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Orochia credits (tips and unlocks paid from a balance). The wallet is not built yet: with
# Orochia credits (the wallet) are always a way to pay; they are bought through a gateway above.
# PAYMENTS_CREDITS_MODE=test adds "Test top-up — no charge" (ignored on the indexed public deployment).
PAYMENTS_CREDITS_MODE=test

# Factory reset of the database from the admin console, and automatic rebuild by the release job when the migration
# history was squashed. Development only: ignored on the indexed public production, whatever it says.
OROCHIA_ALLOW_DATABASE_RESET=true
# Encrypts payout account details at rest (AES-256-GCM). ≥ 32 characters; mandatory in production
# (openssl rand -hex 32). Changing it makes saved payout accounts unreadable: creators re-enter them.
PAYOUT_ENCRYPTION_KEY=

# Sign in with Google / Facebook — a provider is offered only when both its values are set.
# Redirect URI to register with the provider: ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/<google|facebook>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Transactional e-mail (content-report alerts, invitations) from mg.orochia.com: Resend when
# RESEND_API_KEY is set, Mailgun otherwise. Without either nothing is sent (records are written first).
RESEND_API_KEY=
# Outside production nothing is delivered (messages go to the log) unless MAIL_DELIVERY=on.
MAIL_DELIVERY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.orochia.com
# EU region: https://api.eu.mailgun.net
MAILGUN_API_URL=https://api.mailgun.net
MAIL_FROM=Orochia <no-reply@mg.orochia.com>
COMPLIANCE_ALERT_EMAIL=
# E-mail templates (apps/web/mail-templates/<id>/<locale>/subject.txt, body.html, body.txt + _layout/).
#   local — the files of this repository (default outside production)
#   bunny — the same tree under mail-templates/ in the Bunny Storage zone above (BUNNY_STORAGE_API_KEY, _ZONE,
#           _ENDPOINT), published with `npm run mail:templates:push -- --apply` (default in production). A template
#           missing or unreachable there falls back to the bundled one, with a warning in the log.
MAIL_TEMPLATES_SOURCE=local
# Seconds a template read from Bunny is kept in memory (default 300): how long an edit takes to reach the instances.
# MAIL_TEMPLATES_CACHE_TTL=300
# Another folder of templates (default: apps/web/mail-templates).
# MAIL_TEMPLATES_DIR=

# The operator console (krizaka/orochia-admin) calls the admin API with this service token (32+ characters, the same
# value on both deployments). It opens ADMIN routes only and acts as the owner (OROCHIA_OWNER_EMAIL). Unset: refused.
OROCHIA_ADMIN_API_TOKEN=

# ── Mobile push (the Orochia app, krizaka/orochia-mobile) ─────────────────────────────────────
# Pushes go through the Expo Push Service (FCM on Android, APNs on iOS — their keys live in the app's EAS project).
# They leave only in production, or with PUSH_DELIVERY=on; PUSH_DELIVERY=off stops them in production too.
# EXPO_ACCESS_TOKEN: needed only when "enhanced push security" is on in the Expo project.
PUSH_DELIVERY=
EXPO_ACCESS_TOKEN=
