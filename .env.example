# -------------------------------------------------------------
# Orochia Platform Environment Configuration
# -------------------------------------------------------------

# Core Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=super_secret_jwt_hmac_signing_key_replace_in_production_min_32_chars

# Database (PostgreSQL / DigitalOcean Managed Database)
DATABASE_URL=postgresql://orochia_user:orochia_secret@localhost:5432/orochia_db?sslmode=disable
DATABASE_MAX_CONNECTIONS=20

# Cache & Rate Limiting (Redis / DigitalOcean Managed Redis)
REDIS_URL=redis://localhost:6379

# Bunny.net Stream API Configuration
BUNNY_STREAM_API_KEY=your_bunny_stream_api_key_here
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_HOSTNAME=vz-123456.b-cdn.net
BUNNY_STREAM_TOKEN_AUTH_KEY=your_bunny_token_authentication_secret_key
BUNNY_WEBHOOK_SECRET=your_bunny_webhook_signing_secret

# Monetization & Payment Gateways
# Active Provider: "ccbill" | "segpay" | "crypto" | "stripe"
PAYMENT_DEFAULT_GATEWAY=ccbill
PLATFORM_FEE_PERCENTAGE=10

# CCBill (Adult Processor)
CCBILL_CLIENT_ACCOUNT=950000
CCBILL_CLIENT_SUBACCOUNT=0000
CCBILL_FORM_NAME=0000
CCBILL_SALT=your_ccbill_salt_encryption_key
CCBILL_FLEXFORM_ID=flexform-orochia-prod

# Segpay (Adult Processor)
SEGPAY_MERCHANT_ID=12345
SEGPAY_PACKAGE_ID=67890
SEGPAY_SECRET_KEY=your_segpay_secret_key

# Crypto Gateway (NowPayments / BTCPay)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# Stripe (Staging / Non-adult deployment interface)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret

# OpenTelemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_AUTH_TOKEN=metrics_bearer_token_for_prometheus_scraping
