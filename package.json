{
  "name": "orochia-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Orochia — the creator video platform: web app, API and packages (db, media, payments).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint --workspaces --if-present && npm run check:app-links && npm run check:i18n && npm run ratchet && npm run lint:sg:test && npm run lint:sg",
    "check:app-links": "node scripts/check-app-links.mjs",
    "check:i18n": "krizaka-i18n check apps/web/messages && krizaka-i18n scan apps/web/app apps/web/components apps/web/lib --allow Orochia,OROCHIA,Krizaka,KRIZAKA,Bunny,PayPal,USDT,BTC,IBAN,BIC --skip /app/api/",
    "ratchet": "krizaka-ratchet",
    "ratchet:update": "krizaka-ratchet --update",
    "typecheck": "node apps/web/scripts/gen-docs-bundle.mjs && npm run lint --workspaces --if-present && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node apps/web/scripts/gen-docs-bundle.mjs && vitest run",
    "dev:dataset": "node scripts/dev-dataset/seed.mjs",
    "dev:thumbnails": "node scripts/dev-dataset/thumbnails.mjs",
    "dev:catalogue:accounts": "node scripts/dev-dataset/accounts.mjs",
    "dev:catalogue:make": "node scripts/dev-dataset/orazaka-batch.mjs",
    "dev:catalogue:review": "node scripts/dev-dataset/review.mjs",
    "dev:catalogue:seed": "node scripts/dev-dataset/seed-catalogue.mjs",
    "dev:catalogue:activity": "node scripts/dev-dataset/activity.mjs",
    "dev:catalogue:measure": "node scripts/dev-dataset/measure.mjs",
    "dev:catalogue:cleanup": "node scripts/dev-dataset/cleanup.mjs",
    "test:e2e": "node e2e/scenarios.mjs",
    "test:e2e:player": "node e2e/player-fullscreen.mjs",
    "test:a11y": "node e2e/a11y.mjs",
    "test:rail": "node e2e/rail-fixed.mjs",
    "journey:dev": "node scripts/journey-dev.mjs",
    "test:ui-crawl": "node e2e/ui-crawl.mjs",
    "test:player-iphone": "node e2e/player-iphone.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run docs:generate -- --check",
    "db:up": "docker compose -f deploy/docker/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f deploy/docker/docker-compose.dev.yml down",
    "db:generate": "npm run generate --workspace=packages/db --",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "db:owner": "npm run owner --workspace=packages/db --",
    "db:test-accounts": "npm run test-accounts --workspace=packages/db --",
    "db:check": "npm run check --workspace=packages/db",
    "db:studio": "npm run studio --workspace=packages/db",
    "db:status": "node scripts/db.mjs status",
    "db:reset": "node scripts/db.mjs reset",
    "db:psql": "node scripts/db.mjs psql",
    "db:dump": "node scripts/db.mjs dump",
    "db:restore": "node scripts/db.mjs restore",
    "docs:generate": "node scripts/generate-docs.mjs",
    "workspace": "node scripts/workspace.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "record:tour": "node scripts/record-tour.mjs",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:start": "node scripts/demo.mjs start",
    "mail:templates:preview": "tsx apps/web/scripts/mail-templates.ts preview",
    "mail:templates:push": "tsx apps/web/scripts/mail-templates.ts push",
    "quota:reconcile": "tsx apps/web/scripts/quota-reconcile.ts",
    "lint:sg": "node scripts/sg-ratchet.mjs",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "node scripts/sg-ratchet.mjs --update",
    "sg:fix": "node scripts/sg-fix.mjs"
  },
  "keywords": [
    "video-streaming",
    "creator-economy",
    "bunny-stream",
    "hls",
    "nextjs",
    "drizzle-orm",
    "open-source"
  ],
  "author": "Krizaka Core Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@axe-core/playwright": "^4.13.0",
    "@krizaka/i18n": "^0.1.0",
    "playwright": "^1.64.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "postcss-selector-parser": "^7.1.6"
  }
}
