{
  "name": "@orochia/db",
  "version": "1.0.0",
  "description": "PostgreSQL schema (Drizzle, the source of truth), migrations and migrator, connection pool, LISTEN/NOTIFY, development seed.",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/seed.ts",
    "owner": "tsx src/owner-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build:migrator": "esbuild src/migrate.ts --bundle --platform=node --target=node20 --external:pg-native --outfile=dist/migrate.cjs",
    "check": "drizzle-kit check",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.11.8",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
