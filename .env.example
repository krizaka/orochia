# -------------------------------------------------------------
# Orochia — environment template (copy to .env for local development)
# In production every secret below is mandatory: a missing value makes the
# request that needs it fail with 503 instead of running on a placeholder.
# -------------------------------------------------------------

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# At least 32 random characters (e.g. `openssl rand -hex 32`)
AUTH_SESSION_SECRET=

# Local only: lets the login page switch between the seeded demo accounts and
# settles payments instantly when no gateway is configured. Ignored in production.
# On a development deployment: off = a signed-out visitor's story views and shares are answered but not counted.
# The development address (dev.orochia.com): its pages go to NEXT_PUBLIC_APP_URL with a 308, the API keeps serving (apps/web/lib/dev-host.ts).
# APP_DEV_HOST=
APP_PUBLIC_ACTIONS=on
APP_DEMO_MODE=true
# Universal links / App Links: the Apple Team ID and the Android signing certificate's SHA-256 (comma-separated). Unset = the files are not served.
APP_IOS_TEAM_ID=
APP_ANDROID_CERT_SHA256=
# `on` offers a profile cover that moves (a 3-6 s moment of the creator's own video). Off by default.
APP_VIDEO_BANNER=off
# Opens sign-up (off by default; a development deployment stays closed to newcomers).
AUTH_SIGNUP_ENABLED=true

# Default user — the platform owner (ADMIN, verified). Created or reactivated by the release job
# (migrate.cjs) and by the local seed; an existing account keeps its password.
# AUTH_OWNER_PASSWORD is needed only to create it (10+ characters).
AUTH_OWNER_EMAIL=
AUTH_OWNER_USERNAME=
AUTH_OWNER_NAME=
AUTH_OWNER_PASSWORD=
# ADMIN (default), CREATOR or MEMBER.
# AUTH_OWNER_ROLE=ADMIN

# QA accounts for a deployed environment (npm run db:test-accounts, packages/db): one fan, one creator. Sign-up stays closed.
# AUTH_TEST_FAN_EMAIL=
# AUTH_TEST_FAN_USERNAME=
# AUTH_TEST_FAN_PASSWORD=
# AUTH_TEST_CREATOR_EMAIL=
# AUTH_TEST_CREATOR_USERNAME=
# AUTH_TEST_CREATOR_PASSWORD=
# AUTH_TEST_VIEWER_EMAIL=
# AUTH_TEST_VIEWER_USERNAME=
# AUTH_TEST_VIEWER_PASSWORD=
# AUTH_TEST_DATE_OF_BIRTH=

# PostgreSQL
DATABASE_URL=postgresql://orochia_user:orochia_secret@localhost:5432/orochia_db?sslmode=disable
# CA of a managed PostgreSQL (PEM), verified with TLS; on DigitalOcean App Platform: ${<db>.CA_CERT}
# DATABASE_CA_CERT=
# Connections this process may hold (one pool per process; default 5, at most 50). Budget: (instances + 1 during a
# rolling deploy) × (this + 1 LISTEN) + migrate job + admin ≤ 70 % of the database's usable slots (App Platform dev
# database: 25, 3 reserved for superusers → 22) — see docs/DEPLOYMENT.md, "Database connections".
DATABASE_MAX_CONNECTIONS=5
# Direct (session) connection for LISTEN/NOTIFY and migrations when DATABASE_URL is a PgBouncer transaction pool.
# DATABASE_DIRECT_URL=

# Bunny.net Stream (video)
MEDIA_STREAM_API_KEY=
MEDIA_STREAM_LIBRARY_ID=
MEDIA_STREAM_HOSTNAME=
# Optional collections (UUIDs from Manage library → Collections), to keep the library tidy:
# every new video, story videos, and the originals of editor drafts (deleted with their draft).
MEDIA_STREAM_COLLECTION_ID=
MEDIA_STREAM_STORIES_COLLECTION_ID=
MEDIA_STREAM_DRAFTS_COLLECTION_ID=
MEDIA_STREAM_TOKEN_AUTH_KEY=
# The library's Read-Only API key (Stream → API): Bunny signs every webhook with it (v1, HMAC-SHA256).
MEDIA_STREAM_WEBHOOK_SECRET=

# ── Storage quotas (apps/web/lib/quotas.ts, docs/MEDIA_PIPELINE.md §6) ─────────────────────────
# The application counts what it keeps at Bunny (bytes and minutes, per creator and in total) and refuses an upload
# that does not fit BEFORE signing it (413/429 with a stable code). Sizes: 500MB, 200GB, 1TB or unlimited.
# ABUSE_QUOTAS=off disables the quotas (not the rate limits) — refused in production unless
# ABUSE_QUOTAS_OFF_CONFIRMED=true records that decision. Defaults below are deliberately small for development.
ABUSE_QUOTAS=on
# ABUSE_QUOTAS_OFF_CONFIRMED=
# The whole platform (GB, minutes): past it, new uploads are refused; operators are alerted at the thresholds (%).
ABUSE_QUOTA_PLATFORM_GB=100
ABUSE_QUOTA_PLATFORM_MINUTES=unlimited
ABUSE_QUOTA_ALERT_THRESHOLDS=80,95
# A creator without a plan; named plans an operator gives an account (PATCH /api/admin/storage/<userId>), and the
# plan of ADMIN accounts (the owner).
ABUSE_QUOTA_CREATOR_DEFAULT_GB=10
ABUSE_QUOTA_CREATOR_DEFAULT_MINUTES=600
ABUSE_QUOTA_PLANS=pro=100GB/3000min,unlimited=unlimited
ABUSE_QUOTA_ADMIN_PLAN=unlimited
# Per file, lower than (never above) the hard limits of packages/media/src/limits.ts (4 GB / 180 min, 250 MB, 400 MB).
# ABUSE_QUOTA_VIDEO_MAX_MB=4096
# ABUSE_QUOTA_VIDEO_MAX_MINUTES=180
# ABUSE_QUOTA_STORY_MAX_MB=250
# ABUSE_QUOTA_DRAFT_MAX_MB=400
# Upload sessions (videos, video stories, drafts) per account and 24 h; sessions still waiting for their bytes;
# pictures (avatars, covers, thumbnails, story images) per account and day.
ABUSE_QUOTA_UPLOADS_PER_DAY=50
ABUSE_QUOTA_CONCURRENT_UPLOADS=3
ABUSE_QUOTA_IMAGE_UPLOADS_PER_DAY=100
# Reconciliation with Bunny (also `npm run quota:reconcile` and POST /api/admin/storage): every N minutes, 0 = never.
ABUSE_QUOTA_RECONCILE_INTERVAL_MINUTES=360
# Optional: Bunny's ACCOUNT API key (Account → API) — adds the library's and the storage zone's own totals to each
# reconciliation. MEDIA_STORAGE_ZONE_ID: the zone's numeric id (else it is searched by MEDIA_STORAGE_ZONE).
MEDIA_ACCOUNT_API_KEY=
# The date `node scripts/bunny-library.mjs apply --watermark on` was run: videos created from then carry the burned-in mark,
# so the player draws no second one. Unset while the library has no watermark.
# MEDIA_WATERMARK_SINCE=2026-10-19T21:20:00Z
# MEDIA_STORAGE_ZONE_ID=

# ── Realtime (apps/web/lib/realtime.ts, docs/NOTIFICATIONS.md §3, docs/adr/0001-realtime-transport.md) ──────────
# The bus behind live streams and presence: postgres (LISTEN/NOTIFY, default, no extra service — one to ~3 instances)
# or redis (Redis / Valkey at REALTIME_REDIS_URL — more instances or ~10k+ streams). memory: one process, tests only.
REALTIME_BUS=postgres
# REALTIME_REDIS_URL=redis://localhost:6379
# A stream ends after this many seconds and the client reconnects at once (resumes from its last message).
# REALTIME_STREAM_MAX_SECONDS=300
# Channel prefix on the bus (default orochia:rt:).
# REALTIME_PREFIX=orochia:rt:

# ── Abuse defences (apps/web/lib/abuse/, apps/web/lib/rate-limit.ts, SECURITY.md) ───────────────
# Rate-limit counters: memory (one instance only) or postgres (shared by every instance — required before scaling out).
ABUSE_RATE_LIMIT_STORE=memory
# The visitor's address: a header the edge sets (DigitalOcean App Platform: do-connecting-ip), else the entry
# ABUSE_TRUSTED_PROXY_HOPS from the right of X-Forwarded-For (its left end is whatever the client wrote).
# ABUSE_CLIENT_IP_HEADER=do-connecting-ip
# ABUSE_TRUSTED_PROXY_HOPS=1
# Bot challenge: Cloudflare Turnstile ("Invisible" widget) on sign-up and password reset.
#   auto (default) — on when both keys are set · required — production refuses those actions without keys · off
# Local testing keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
ABUSE_BOT_CHALLENGE=auto
ABUSE_BOT_CHALLENGE_SITE_KEY=
ABUSE_BOT_CHALLENGE_SECRET_KEY=
# Sign-up: seconds a form must have been open before it is sent (bots are faster), extra blocked / allowed domains.
ABUSE_SIGNUP_MIN_FILL_SECONDS=3
# ABUSE_BLOCKED_EMAIL_DOMAINS=
# ABUSE_ALLOWED_EMAIL_DOMAINS=
# Bind signed playback URLs to the viewer's IP (Bunny token IP check). Off by default: check on real traffic first.
# MEDIA_STREAM_TOKEN_BIND_IP=on

# Editor drafts: days a draft is kept (then removed with its files), drafts per account.
MEDIA_DRAFT_RETENTION_DAYS=30
MEDIA_DRAFTS_MAX_PER_USER=20

# Media storage (avatars, thumbnails, story images, drafts' music, 2257 documents). Production requires "bunny".
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_API_KEY=
MEDIA_STORAGE_ZONE=
MEDIA_STORAGE_ENDPOINT=storage.bunnycdn.com
MEDIA_CDN_HOSTNAME=

# Payments — a gateway is offered only when ALL of its variables are set.
PAYMENTS_PLATFORM_FEE_PERCENTAGE=10

# CCBill (FlexForms dynamic pricing; postbacks signed by your webhook relay)
PAYMENTS_CCBILL_CLIENT_ACCOUNT=
PAYMENTS_CCBILL_CLIENT_SUBACCOUNT=
PAYMENTS_CCBILL_FORM_NAME=
PAYMENTS_CCBILL_SALT=
PAYMENTS_CCBILL_WEBHOOK_SECRET=

# Segpay
PAYMENTS_SEGPAY_MERCHANT_ID=
PAYMENTS_SEGPAY_PACKAGE_ID=
PAYMENTS_SEGPAY_SECRET_KEY=

# NowPayments (crypto) — IPN callback: ${NEXT_PUBLIC_APP_URL}/api/webhooks/payments/crypto
PAYMENTS_NOWPAYMENTS_API_KEY=
PAYMENTS_NOWPAYMENTS_IPN_SECRET=

# Stripe — webhook endpoint: ${NEXT_PUBLIC_APP_URL}/api/webhooks/payments/stripe
PAYMENTS_STRIPE_SECRET_KEY=
PAYMENTS_STRIPE_WEBHOOK_SECRET=

# Observability — bearer token for /api/metrics (mandatory in production)
OBSERVABILITY_METRICS_TOKEN=

# AI — the Explorer (semantic search, "similar videos") runs on Orazaka, never on a model provider. Both optional: without
# them the Explorer is full-text search alone. The key is scoped `ai:embed` (embeddings only):
# node scripts/dev-deploy.mjs service-account orochia-explorer --scopes ai:embed,reco:sync,reco:read --prefix AI_ENGINE --out <file> (krizaka/orazaka)
AI_ENGINE_URL=
AI_ENGINE_API_KEY=
# The recommender knows people by an HMAC of their account id with this key (ADR-078); unset locally: derived.
AI_PSEUDONYM_KEY=

# Orochia credits (the wallet) are always a way to pay; they are bought through a gateway above.
# PAYMENTS_CREDITS_MODE=test adds "Test top-up — no charge" (ignored on the indexed public deployment).
PAYMENTS_CREDITS_MODE=test

# Factory reset of the database from the admin console, and automatic rebuild by the release job when the migration
# history was squashed. Development only: ignored on the indexed public production, whatever it says.
DATABASE_ALLOW_RESET=true
# Encrypts payout account details at rest (AES-256-GCM). ≥ 32 characters; mandatory in production
# (openssl rand -hex 32). Changing it makes saved payout accounts unreadable: creators re-enter them.
PAYMENTS_PAYOUT_ENCRYPTION_KEY=

# Sign in with Google / Facebook — a provider is offered only when both its values are set.
# Redirect URI to register with the provider: ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/<google|facebook>/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_FACEBOOK_APP_ID=
AUTH_FACEBOOK_APP_SECRET=

# Transactional e-mail (content-report alerts, invitations) from mg.orochia.com. MAIL_PROVIDER picks the service:
#   resend  — MAIL_API_KEY · mailgun — MAIL_API_KEY + MAIL_DOMAIN (+ MAIL_API_URL, EU region: https://api.eu.mailgun.net).
# Unset: nothing is sent (records are written first).
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_DOMAIN=mg.orochia.com
MAIL_API_URL=https://api.mailgun.net
# Outside production nothing is delivered (messages go to the log) unless MAIL_DELIVERY=on.
MAIL_DELIVERY=
MAIL_FROM=Orochia <no-reply@mg.orochia.com>
MAIL_COMPLIANCE_ALERT_TO=
# E-mail templates (apps/web/mail-templates/<id>/<locale>/subject.txt, body.html, body.txt + _layout/).
#   local — the files of this repository (default outside production)
#   bunny — the same tree under mail-templates/ in the Bunny Storage zone above (MEDIA_STORAGE_API_KEY, _ZONE,
#           _ENDPOINT), published with `npm run mail:templates:push -- --apply` (default in production). A template
#           missing or unreachable there falls back to the bundled one, with a warning in the log.
MAIL_TEMPLATES_SOURCE=local
# Seconds a template read from Bunny is kept in memory (default 300): how long an edit takes to reach the instances.
# MAIL_TEMPLATES_CACHE_TTL=300
# Another folder of templates (default: apps/web/mail-templates).
# MAIL_TEMPLATES_DIR=

# The operator console (app/console, served on admin.<domain> by this same app — the former krizaka/orochia-admin)
# calls the admin API with this service token (32+ characters). It opens ADMIN routes only and acts as the owner
# (AUTH_OWNER_EMAIL). Unset: refused.
OPERATOR_API_TOKEN=
# The platform API the console operates (this deployment's own public address), and the site its links point to.
OPERATOR_API_URL=http://localhost:3000
# NEXT_PUBLIC_OPERATOR_PLATFORM_URL=http://localhost:3000
# The console's own database (never the platform's): operator account, sessions, operator log. Schema created on first use.
DATABASE_CONSOLE_URL=postgresql://orochia_user:orochia_secret@localhost:5432/orochia_admin?sslmode=disable
# The single operator account (nobody signs up).
AUTH_OPERATOR_EMAIL=
AUTH_OPERATOR_NAME=
AUTH_OPERATOR_PASSWORD=
# Client addresses allowed on the console host (comma-separated, do-connecting-ip), sign-in included. Empty in
# production: nobody. The console is reached on admin.<domain> only; /console does not exist on the other hosts.
AUTH_ALLOWED_IPS=

# ── Mobile push (the Orochia app, krizaka/orochia-mobile) ─────────────────────────────────────
# Pushes go through the Expo Push Service (FCM on Android, APNs on iOS — their keys live in the app's EAS project).
# They leave only in production, or with PUSH_DELIVERY=on; PUSH_DELIVERY=off stops them in production too.
# PUSH_ACCESS_TOKEN: needed only when "enhanced push security" is on in the Expo project.
PUSH_DELIVERY=
PUSH_ACCESS_TOKEN=
